[Unit]
Description=chessNext public skin catalog
After=network.target

[Service]
Type=simple
User=skin-catalog
Group=skin-catalog
Environment=SKIN_CATALOG_ROOT=/srv/chessnext/skin-catalog/public
# Optional: enable the independent board-skin catalog endpoints.
# Environment=SKIN_BOARD_CATALOG_ROOT=/srv/chessnext/board-skin-catalog/public
# Enable only with an operator-supplied, licensed book data set.
# Environment=CHESSNEXT_BOOK_ROOT=/srv/chessnext/book/public
# Public version metadata only; release notes are supplied by the operator.
# Environment=CHESSNEXT_RELEASE_ROOT=/srv/chessnext/releases/public
# Optional private, append-only feedback inbox. Create it for skin-catalog:skin-catalog first.
# Environment=CHESSNEXT_FEEDBACK_ROOT=/srv/chessnext/feedback/inbox
# If enabled, also uncomment the matching ReadWritePaths below.
Environment=SKIN_CATALOG_ADDRESS=127.0.0.1
Environment=SKIN_CATALOG_PORT=8087
ExecStart=/usr/local/bin/chessnext-skin-catalog
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Optional feedback directory must be created with owner skin-catalog and mode 0700.
# ReadWritePaths=/srv/chessnext/feedback/inbox
UMask=0027

[Install]
WantedBy=multi-user.target
